*_test.py
*_batch.py

# Testing infrastructure. Admit tracked test modules by pattern, not by name —
# the old per-file allowlist meant a new test was invisible to git until someone
# remembered to add it here (tests/test_sql_shell.py sat untracked on disk).
# `tests/` must be re-included (`!tests/`) before `tests/*` can be selectively
# negated: git cannot re-include a file whose parent directory is excluded.
tests/
!tests/
tests/*
!tests/__init__.py
!tests/conftest.py
!tests/test_*.py
# Credential fixtures stay out regardless of where they sit in the tree.
tests/**/*.env
tests/**/credentials*

# Node (local MCP install — generated by uv run setup-mcp)
node_modules/
package.json
package-lock.json
/docs/superpowers/
# Confluent CLI `api-key create --output-file` drops these in the CWD, named for
