credentials.json
# Google OAuth client + cached token for `wsa accept-account-invitation` /
# `dispenser-upload`. Prefer keeping these in ~/.wsa/ (where wsa already caches
# gmail-token.json) — these patterns are the backstop if one lands here.
gmail-credentials.json
gmail-token.json
sheets-credentials.json
client_secret_*.json

# Generated configs (contain secrets)
generated/

# Workshop orchestrator run artifacts — per-attendee Terraform state, plugin
# cache, logs, and generated credential cards (contain secrets).
runs/

# `wsa` run artifacts. wsa resolves its output directory relative to the CWD
# (workshop-setup-accelerator internal/output/output.go:16,38), so running it
# against this repo's spec lands them HERE, inside the checkout. Each run dir
# holds terraform/aws-shared/terraform.tfstate and terraform/aws/terraform.tfstate
# — i.e. the literal Postgres password and every Kafka/SR/Flink secret — plus the
# dispenser build-output.csv. Without this rule one `git add -A` commits all of it.
wsa-output/

# Derived wsa spec written by create-workshop / `workshop build --prefix` when a
# prefix override is requested (wsa has no --var flag; see scripts/workshop/wsa.py).
.wsa-spec-generated.yaml

