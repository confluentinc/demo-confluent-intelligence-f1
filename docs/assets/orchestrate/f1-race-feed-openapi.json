{
  "openapi": "3.0.3",
  "info": {
    "title": "F1 Race Feed",
    "version": "1.0.0",
    "description": "Live race data for the read-only River Racing social-media agent."
  },
  "servers": [
    {
      "url": "https://REPLACE-WITH-YOUR-PUBLIC-URL.example.com"
    }
  ],
  "paths": {
    "/race-feed/{prefix}": {
      "get": {
        "operationId": "get_race_feed",
        "summary": "Get the live race feed",
        "description": "Returns the current standings, River Racing tire status, latest pit recommendation, and recent headline events for one workshop attendee.",
        "parameters": [
          {
            "name": "prefix",
            "in": "path",
            "required": true,
            "description": "The attendee environment prefix, such as f1wp004.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The attendee's current race feed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RaceFeed"
                }
              }
            }
          },
          "404": {
            "description": "No feed exists for the supplied attendee prefix."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RaceFeed": {
        "type": "object",
        "required": [
          "prefix",
          "lap",
          "driver",
          "team",
          "car_number",
          "standings",
          "headline_events",
          "live",
          "updated_at"
        ],
        "properties": {
          "prefix": {
            "type": "string",
            "description": "Attendee prefix this feed belongs to."
          },
          "lap": {
            "type": "integer",
            "description": "Current lap number out of 60."
          },
          "driver": {
            "type": "string",
            "description": "River Racing driver name."
          },
          "team": {
            "type": "string",
            "description": "Team name."
          },
          "car_number": {
            "type": "integer",
            "description": "River Racing car number."
          },
          "our_position": {
            "type": "integer",
            "nullable": true,
            "description": "Current race position, where 1 is the leader."
          },
          "standings": {
            "type": "array",
            "description": "Current leaders plus the River Racing car.",
            "items": {
              "$ref": "#/components/schemas/StandingEntry"
            }
          },
          "tire": {
            "allOf": [
              {
                "$ref": "#/components/schemas/TireStatus"
              }
            ],
            "nullable": true,
            "description": "Current tire status; null until the car_state table is built."
          },
          "latest_pit_decision": {
            "allOf": [
              {
                "$ref": "#/components/schemas/PitDecision"
              }
            ],
            "nullable": true,
            "description": "Most recent AI pit recommendation; null until pit_decisions is built."
          },
          "headline_events": {
            "type": "array",
            "description": "Recent notable race moments, newest last.",
            "items": {
              "type": "string"
            }
          },
          "live": {
            "type": "boolean",
            "description": "True when race records have arrived recently."
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp of the latest snapshot in UTC."
          }
        }
      },
      "StandingEntry": {
        "type": "object",
        "properties": {
          "position": {
            "type": "integer",
            "nullable": true
          },
          "car_number": {
            "type": "integer",
            "nullable": true
          },
          "driver": {
            "type": "string",
            "nullable": true
          },
          "team": {
            "type": "string",
            "nullable": true
          },
          "gap_to_leader_sec": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "last_lap_time_sec": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "pit_stops": {
            "type": "integer",
            "nullable": true
          },
          "tire_compound": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "TireStatus": {
        "type": "object",
        "properties": {
          "compound": {
            "type": "string",
            "nullable": true
          },
          "age_laps": {
            "type": "integer",
            "nullable": true
          },
          "front_left_temp_c": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "anomaly": {
            "type": "boolean"
          }
        }
      },
      "PitDecision": {
        "type": "object",
        "properties": {
          "lap": {
            "type": "integer",
            "nullable": true
          },
          "suggestion": {
            "type": "string",
            "nullable": true,
            "description": "PIT NOW, PIT SOON, or STAY OUT."
          },
          "reasoning": {
            "type": "string",
            "nullable": true
          },
          "recommended_tire_compound": {
            "type": "string",
            "nullable": true
          }
        }
      }
    }
  }
}
