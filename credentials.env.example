# Required by workshop build and teardown. Never put real values in this file.
TF_VAR_confluent_cloud_api_key=
TF_VAR_confluent_cloud_api_secret=
TF_VAR_owner_email=
TF_VAR_aws_bedrock_access_key=
TF_VAR_aws_bedrock_secret_key=

# Organizer-specific, non-secret workshop setting.
WORKSHOP_EMAIL_PATTERN=organizer+f1wp{N}@example.com
